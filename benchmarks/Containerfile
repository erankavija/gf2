# benchmarks/Containerfile
#
# Reproducible reference-library benchmark image for the gf2 FieldMatrix
# epic (jit:64c88ae4 / jit:bb85c68a). Builds fflas-ffpack and M4RI from
# pinned upstream tarballs against the Debian-slim toolchain so reference
# numbers are not contaminated by whatever the host has installed.
#
# Designed for **rootless podman** but compatible with Docker.
#
# Build:
#   podman build -t gf2-bench:ref -f benchmarks/Containerfile benchmarks/
#
# Run (see benchmarks/run.sh for the full incantation):
#   podman run --rm -v $PWD/benchmarks:/work:Z gf2-bench:ref /work/in_container_run.sh
#
# Pinning notes:
#   * Base image is pinned by digest in benchmarks/image.lock.
#   * Debian package versions are pinned by Debian "bookworm" (stable) — Debian
#     does not allow sub-major upgrades within a release, so package versions
#     are stable for the lifetime of bookworm. Re-build of the base image will
#     therefore reproduce the exact same toolchain.
#   * fflas-ffpack / Givaro / M4RI tarballs are pinned by version + sha256.
#
# All compilers run with -O3 -march=native to mirror the gf2 release build.

# Base image — pinned by digest. The dated tag `bookworm-20260421-slim`
# is non-floating per Debian's tag policy (dated slim tags are immutable
# once published); the `@sha256:...` digest is defence in depth against
# registry mutation / mirror substitution. Resolved 2026-04-26 against
# docker.io/library/debian via the registry API (OCI image index;
# podman resolves to the right platform-specific manifest via the
# index). To refresh: pick a newer dated tag, fetch its digest with
# `podman manifest inspect ...`, and update both this line and
# `image.lock` [base].digest in lockstep — `run.sh` cross-checks them.
FROM docker.io/library/debian:bookworm-20260421-slim@sha256:f9c6a2fd2ddbc23e336b6257a5245e31f996953ef06cd13a59fa0a1df2d5c252

# Build dependencies. Pin major versions explicitly. We rely on Debian
# bookworm's "stable" semantics — point releases do not change ABI/major
# versions, so the resulting image is reproducible to the package level.
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential=12.9 \
        ca-certificates \
        cmake=3.25.1-1 \
        curl \
        gcc-12=12.2.0-14+deb12u1 \
        g++-12=12.2.0-14+deb12u1 \
        libgmp-dev=2:6.2.1+dfsg1-1.1 \
        libopenblas-dev=0.3.21+ds-4 \
        liblapack-dev=3.11.0-2 \
        m4=1.4.19-3 \
        make \
        pkg-config=1.8.1-1 \
        procps \
        util-linux \
        xz-utils \
        bzip2 \
 && rm -rf /var/lib/apt/lists/*

# Force gcc-12 / g++-12 (Debian bookworm's default gcc-12 chain).
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100

ENV CFLAGS="-O3 -march=native -fPIC"
ENV CXXFLAGS="-O3 -march=native -fPIC -std=c++17"
ENV LDFLAGS=""

# ---------------------------------------------------------------------------
# Givaro 4.2.0 — algebraic primitives layer (required by fflas-ffpack).
# ---------------------------------------------------------------------------
ARG GIVARO_VERSION=4.2.0
ARG GIVARO_SHA256=865e228812feca971dfb6e776a7bc7ac959cf63ebd52b4f05492730a46e1f189
RUN curl -fsSL -o /tmp/givaro.tar.gz \
        https://github.com/linbox-team/givaro/releases/download/v${GIVARO_VERSION}/givaro-${GIVARO_VERSION}.tar.gz \
 && echo "${GIVARO_SHA256}  /tmp/givaro.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/givaro.tar.gz \
 && cd /tmp/givaro-${GIVARO_VERSION} \
 && ./configure --prefix=/usr/local --enable-shared --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/givaro-${GIVARO_VERSION} /tmp/givaro.tar.gz

# ---------------------------------------------------------------------------
# fflas-ffpack 2.5.0 — dense linear algebra over finite fields.
# ---------------------------------------------------------------------------
ARG FFLAS_VERSION=2.5.0
ARG FFLAS_SHA256=dafb4c0835824d28e4f823748579be6e4c8889c9570c6ce9cce1e186c3ebbb23
RUN curl -fsSL -o /tmp/fflas.tar.gz \
        https://github.com/linbox-team/fflas-ffpack/releases/download/v${FFLAS_VERSION}/fflas-ffpack-${FFLAS_VERSION}.tar.gz \
 && echo "${FFLAS_SHA256}  /tmp/fflas.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/fflas.tar.gz \
 && cd /tmp/fflas-ffpack-${FFLAS_VERSION} \
 && ./configure --prefix=/usr/local \
        --with-givaro=/usr/local \
        --with-blas-libs="-lopenblas" \
        --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/fflas-ffpack-${FFLAS_VERSION} /tmp/fflas.tar.gz

# ---------------------------------------------------------------------------
# M4RI 20260122 — dense GF(2) linear algebra (the M4RM reference).
# ---------------------------------------------------------------------------
ARG M4RI_VERSION=20260122
ARG M4RI_SHA256=7e033ca1fd36be8861e2f67d9d124c398fc0d830209bb0226462485876346404
RUN curl -fsSL -o /tmp/m4ri.tar.gz \
        https://github.com/malb/m4ri/releases/download/${M4RI_VERSION}/m4ri-${M4RI_VERSION}.tar.gz \
 && echo "${M4RI_SHA256}  /tmp/m4ri.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/m4ri.tar.gz \
 && cd /tmp/m4ri-${M4RI_VERSION} \
 && ./configure --prefix=/usr/local --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/m4ri-${M4RI_VERSION} /tmp/m4ri.tar.gz

# === linbox begin ===
# ---------------------------------------------------------------------------
# LinBox 1.7.1 — exact linear algebra over finite fields, used as the
# reference for charpoly / minpoly / solve cells where fflas-ffpack does
# not expose a directly comparable solution-level API. Builds on top of
# the already-pinned Givaro 4.2.0 / fflas-ffpack 2.5.0 stack; LinBox's
# only mandatory dependency is fflas-ffpack ≥ 2.5.0 (per its
# configure.ac), and the optional NTL/FLINT/IML/MPFR pieces are not
# needed for our finite-field-only scope.
#
# `--disable-openmp` mirrors the existing fflas posture and ensures the
# single-thread requirement of the SOTA acceptance protocol § 5 is met
# without runtime ENV overrides. `--disable-static` matches sibling pins.
# ---------------------------------------------------------------------------
ARG LINBOX_VERSION=1.7.1
ARG LINBOX_SHA256=a2b5f910a54a46fa75b03f38ad603cae1afa973c95455813d85cf72c27553bd8
RUN curl -fsSL -o /tmp/linbox.tar.gz \
        https://github.com/linbox-team/linbox/releases/download/v${LINBOX_VERSION}/linbox-${LINBOX_VERSION}.tar.gz \
 && echo "${LINBOX_SHA256}  /tmp/linbox.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/linbox.tar.gz \
 && cd /tmp/linbox-${LINBOX_VERSION} \
 && ./configure --prefix=/usr/local \
        --with-givaro=/usr/local \
        --with-fflas-ffpack=/usr/local \
        --with-blas-libs="-lopenblas" \
        --disable-openmp \
        --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/linbox-${LINBOX_VERSION} /tmp/linbox.tar.gz
# === linbox end ===

# === m4rie begin ===
# ---------------------------------------------------------------------------
# M4RIE 20250128 — dense GF(2^e) linear algebra (the M4RM-NJ reference) for
# 2 ≤ e ≤ 16. Depends on M4RI (built directly above) for the underlying
# GF(2) bit-matrix layer and the Newton-John tables. Promoted as the
# canonical reference for GF(2^4)/GF(2^8)/GF(2^16) under the SOTA reference
# acceptance protocol (jit:507b0036).
# ---------------------------------------------------------------------------
ARG M4RIE_VERSION=20250128
ARG M4RIE_SHA256=96f1adafd50e6a0b51dc3aa1cb56cb6c1361ae7c10d97dc35c3fa70822a55bd7
RUN curl -fsSL -o /tmp/m4rie.tar.gz \
        https://github.com/malb/m4rie/releases/download/${M4RIE_VERSION}/m4rie-${M4RIE_VERSION}.tar.gz \
 && echo "${M4RIE_SHA256}  /tmp/m4rie.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/m4rie.tar.gz \
 && cd /tmp/m4rie-${M4RIE_VERSION} \
 && ./configure --prefix=/usr/local --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/m4rie-${M4RIE_VERSION} /tmp/m4rie.tar.gz
# === m4rie end ===

# === ntl begin ===
# ---------------------------------------------------------------------------
# NTL 11.6.0 — number-theoretic library (Victor Shoup). Used as a
# secondary GF(p) reference for fgemm/inv/solve/charpoly via the
# single-precision `zz_p` matrix path (NTL_SP_BOUND ≥ 2^31-1 covers
# all four reference primes). Promoted by jit:73ab8eef.
#
# NTL is configured with NTL_GMP_LIP=on so big-integer ops route to
# GMP (already present from libgmp-dev); shared-lib install lands at
# /usr/local/lib/libntl.so. License: LGPL-2.1-or-later.
# ---------------------------------------------------------------------------
ARG NTL_VERSION=11.6.0
ARG NTL_SHA256=bc0ef9aceb075a6a0673ac8d8f47d5f8458c72fe806e4468fbd5d3daff056182
RUN curl -fsSL -o /tmp/ntl.tar.gz \
        https://libntl.org/ntl-${NTL_VERSION}.tar.gz \
 && echo "${NTL_SHA256}  /tmp/ntl.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/ntl.tar.gz \
 && cd /tmp/ntl-${NTL_VERSION}/src \
 && ./configure PREFIX=/usr/local SHARED=on NTL_GMP_LIP=on \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/ntl-${NTL_VERSION} /tmp/ntl.tar.gz
# === ntl end ===

# === flint begin ===
# ---------------------------------------------------------------------------
# FLINT 3.5.0 — fast library for number theory. Used as a secondary
# GF(p) reference for fgemm/pluq/echelon/inv/solve/charpoly/minpoly
# via `nmod_mat` (single-word modular matrices, modulus up to 2^63-1
# covers all four reference primes). Promoted by jit:73ab8eef.
#
# FLINT depends on GMP (already installed) and MPFR. We add the
# matching apt-pinned `libmpfr-dev` here so the FLINT layer remains
# fully reproducible. License: LGPL-3.0-or-later.
# ---------------------------------------------------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libmpfr-dev=4.2.0-1 \
 && rm -rf /var/lib/apt/lists/*

ARG FLINT_VERSION=3.5.0
ARG FLINT_SHA256=3982f385f00610a944e0152eb0a29893b2366fa640e8f5f3076c47564cf7e2a6
RUN curl -fsSL -o /tmp/flint.tar.gz \
        https://www.flintlib.org/download/flint-${FLINT_VERSION}.tar.gz \
 && echo "${FLINT_SHA256}  /tmp/flint.tar.gz" | sha256sum -c - \
 && tar -C /tmp -xf /tmp/flint.tar.gz \
 && cd /tmp/flint-${FLINT_VERSION} \
 && ./configure --prefix=/usr/local --disable-static \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/flint-${FLINT_VERSION} /tmp/flint.tar.gz
# === flint end ===

# Refresh the loader cache so the freshly installed shared libs are picked up.
RUN ldconfig

# ---------------------------------------------------------------------------
# Reference benchmark sources are bind-mounted at /work at run time.
# ---------------------------------------------------------------------------
WORKDIR /work

# Note (jit:96fde7c7): the sparse cross-equality smoke
# (`benchmarks/reference/sparse_smoke.cpp`) loads a gf2-core-emitted
# ground-truth binary at `/work/expected/sparse_smoke_n16.bin` at
# runtime. The image deliberately does NOT install a Rust toolchain
# — that would inflate the image considerably and the regen path
# (`cargo run --release -p gf2-coding --example
# sparse_smoke_emit_expected --features bench-csv`) runs on the host
# in `benchmarks/smoke.sh` (Step 0) and produces the ground-truth
# file on disk; the bind-mount makes it visible inside the container.
# Build-time validation of the gf2-core path is not needed in this
# image — the `cargo-ci` gate validates gf2-core; this image only
# carries the C++ reference libraries.

# Compile-time smoke check: verify all installed libraries are visible
# at the expected paths so a broken image fails to build, not at run
# time. fflas-ffpack/givaro use pkg-config; m4ri/m4rie/linbox/ntl/flint
# are plain Autoconf installs and exposed by header path / library file.
RUN pkg-config --cflags fflas-ffpack givaro \
 && pkg-config --libs fflas-ffpack givaro \
 && test -f /usr/local/include/m4ri/m4ri.h \
 && test -f /usr/local/lib/libm4ri.so \
 && test -f /usr/local/include/m4rie/m4rie.h \
 && test -f /usr/local/lib/libm4rie.so \
 && test -f /usr/local/include/NTL/mat_lzz_p.h \
 && test -f /usr/local/lib/libntl.so \
 && test -f /usr/local/include/flint/nmod_mat.h \
 && test -f /usr/local/lib/libflint.so

# Default command lists the installed reference-library versions so
# `podman run --rm gf2-bench:ref` is self-documenting.
CMD ["/bin/bash", "-c", "\
echo 'gf2 reference benchmark image'; \
echo '----------------------------'; \
echo 'gcc:        '$(gcc -dumpfullversion -dumpversion); \
echo 'g++:        '$(g++ -dumpfullversion -dumpversion); \
echo 'givaro/fflas: '$(pkg-config --modversion givaro fflas-ffpack 2>/dev/null | paste -sd ' / ' -); \
echo 'm4ri:       '$(grep -E '#define +M4RI_VERSION ' /usr/local/include/m4ri/m4ri_config.h 2>/dev/null | awk '{print $3}' | tr -d '\"'); \
echo 'm4rie:      '$(grep -E '#define +M4RIE_VERSION ' /usr/local/include/m4rie/m4rie.h 2>/dev/null | awk '{print $3}' | tr -d '\"'); \
echo 'ntl:        '$(grep -E 'NTL_VERSION ' /usr/local/include/NTL/version.h 2>/dev/null | awk '{print $3}' | tr -d '\"'); \
echo 'flint:      '$(grep -E '#define +FLINT_VERSION ' /usr/local/include/flint/flint.h 2>/dev/null | awk '{print $3}' | tr -d '\"'); \
echo 'openblas:   '$(dpkg -s libopenblas-dev | awk '/^Version:/{print $2}'); \
echo 'gmp:        '$(dpkg -s libgmp-dev    | awk '/^Version:/{print $2}'); \
echo 'mpfr:       '$(dpkg -s libmpfr-dev    | awk '/^Version:/{print $2}'); \
"]

#!/bin/sh
# Stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    revisions="$local_sha --not --remotes"
  else
    revisions="$remote_sha..$local_sha"
  fi
  python3 -B "$root/scripts/check-tracked-budget.py" --range "$revisions" || status=1
done
exit $status

diff --git a/dev/tools/tuning-campaign-support/src/timing.rs b/dev/tools/tuning-campaign-support/src/timing.rs
index a4325c804..7b697c90f 100644
--- a/dev/tools/tuning-campaign-support/src/timing.rs
+++ b/dev/tools/tuning-campaign-support/src/timing.rs
@@ -145,5 +145,24 @@ pub fn execution_windows_with_progress(
     body: &mut impl FnMut(usize),
-    progress: impl FnMut(TimingProgress) -> std::io::Result<()>,
+    mut progress: impl FnMut(TimingProgress) -> std::io::Result<()>,
 ) -> std::io::Result<Vec<TimingSample>> {
-    execution_windows_configured(execution, WINDOWS, TARGET, body, progress)
+    // Rehearsal stand-in: one dispatch per window, constant samples, no clock.
+    const REHEARSAL_CALLS: u64 = 1;
+    const REHEARSAL_ELAPSED_NS: u64 = 1;
+    progress(TimingProgress::CalibrationComplete {
+        calls: REHEARSAL_CALLS,
+    })?;
+    let mut samples = Vec::with_capacity(WINDOWS as usize);
+    for repetition in 0..WINDOWS {
+        body(execution_window_start(execution, repetition));
+        let sample = TimingSample::new(
+            execution,
+            repetition,
+            REHEARSAL_CALLS,
+            REHEARSAL_ELAPSED_NS,
+        )
+        .map_err(std::io::Error::other)?;
+        progress(TimingProgress::WindowComplete(sample))?;
+        samples.push(sample);
+    }
+    Ok(samples)
 }

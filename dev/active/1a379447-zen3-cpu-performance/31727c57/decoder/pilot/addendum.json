  "family": {
    "id": "1362381c-decoder-route-integration",
    "issue": "31727c57",
    "purpose": "decoder-family",
    "description": "Integrated decoder route under the committed coding envelope against conservative single-frame decoding, with Rust 1.95 portable release arms pinned by the live e5f8b3ae build records. Both codes use recorded f32 flooding normalized-min-sum inputs at factor 0.75, iteration cap 50 and per-frame syndrome stopping. Every execution verifies the prepared per-frame error record. Whole-consumer calls include conversion, batch fill, routing, decoding and extraction with pinned workers and no nested pools. Pilot outcomes are exploratory: both codes cover one worker with one-frame and full waves, six and twelve physical workers and twenty-four logical workers. Confirmation selects four predeclared pilot cells spanning worker counts and adds two NR holdouts absent from the calibration inventory, within the fresh ledger bound. Batch-fill latency is reported separately in conversion.batch_fill_ns by the existing zero-iteration stage probe; throughput remains the whole-call metric. Every negative and inconclusive outcome remains recorded; no selectors are changed by this campaign."
  },
  "frozen": {
    "frozen_utc": "2026-10-26T22:22:36Z"
  },
  "effect": {
    "worthwhile_speedup": 1.1,
    "rationale": "Ten percent whole-call improvement is material for this integrated route; the canonical freezer requires the margin above one plus the pilot resolution.",

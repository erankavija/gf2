  "family": {
    "id": "55c3e433-nr-route-pilot",
    "issue": "1d787ed3",
    "purpose": "decoder-family",
    "description": "Exploratory pilot of the NR BG1 Z=384 routes at the current tree. The baseline arm is gf2-coding's LdpcBatchDecoder forced onto the single-frame route (gf2-batch-single-frame-iterations). Each configuration pairs it with the QC-aware intra-frame prototype (qc-decoder, eight sequential single-frame decodes per worker at batch eight) and with AFF3CT's flooding f32 normalized min-sum decoder [Cassagne2019] (aff3ct-flooding-nms-f32-iterations, one clone per pinned worker, at the pin of c077a88b). The matched-algorithm settings all arms share are the recorded AList parity-check matrix, the recorded LLRs, f32 precision, the flooding schedule, normalized min-sum at factor 0.75, the iteration cap of 50 and syndrome stopping, with AFF3CT's syndrome check at depth one. The measured operation is the steady-state decode of 3be770d5: every worker is a thread pinned to one resolved CPU and owns one decoder built before timing, and a timed call makes every worker decode the cell's per-worker batch of the first recorded frames, including LLR conversion, dispatch and extraction of the information-window decisions. Cells are w1-b1, w1-b8, p6-b8, p12-b8 and l24-b8, resolved at run time from the single-core, physical-cores-6, physical-cores-12 and logical-cpus-24 sets. Each arm reports its per-frame iteration counts after timing, direct for gf2 and QC and replay-derived for AFF3CT. History: the FI-3 comparison of 1362381c-ldpc-aff3ct-integration (@/issue/1358d6ab) and the QC-aware study of f63a2464 (@/issue/f63a2464) ran on other ledgers and other trees; this family's ledger starts empty, so prior_trials is empty, and those results are descriptive history that no estimate here reuses. QC against AFF3CT is the ratio of the two pairings of a configuration and is indirect. The family decides nothing by itself; the decision record applies the QC go rule of the plan to its receipt."
  },
  "frozen": {
    "frozen_utc": "2026-11-01T15:20:26Z"
  },
  "effect": {
    "worthwhile_speedup": null,
    "rationale": "The family publishes the NR route pilot and adopts nothing, so it declares no worthwhile speedup.",
    "measurement_resolution": null,
    "resolution_evidence": null,
    "equivalence_margin": 1.1,
    "equivalence_rationale": "Within ten percent at matched settings, a receiver choosing between gf2's production route and AFF3CT [Cassagne2019] gains too little throughput to repay integrating and maintaining a second decoder dependency, so the family reads the arms as equivalent. Fixed before this pilot; the canonical freezer stops when pilot resolution reaches it and never widens it from results.",
    "material_gap_threshold": 1.25,
    "material_gap_rationale": "A steady-state gap of a quarter of a receiver's decode throughput at matched settings outweighs the integration and maintenance cost of a second decoder dependency, so it changes which decoder a receiver deploys and needs attribution; it lies outside the equivalence margin. Fixed before this pilot; the canonical freezer stops when pilot resolution reaches it and never widens it from results."
  },
  "complexity_budget": {
    "max_new_unsafe_kernels": 0,
    "max_added_source_lines": null,
    "maintenance_rationale": "The family selects nothing and adds no production code."
  },

# Rust build artifacts. Unanchored so nested build dirs are caught too
# (e.g. .agents/cache-pool/target, crates/*/target); an anchored
# `/target/` let 1.3 GB of gf2-core build output reach a commit.
target/
# Lockfiles for the standalone dev/ experiment crates and sub-crates, each of
# which resolves its own dependency graph outside the workspace.
Cargo.lock
# The workspace root lockfile is tracked: a harness reproduces with the
# dependency versions it pins.
!/Cargo.lock

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test artifacts
*.profraw
*.profdata
lcov.info
coverage.json
badges/

# Proptest artifacts
proptest-regressions/

# Documentation build
/doc/
*.proptest-regressions
*.gf2

# Lean4 build artifacts
proofs/build/
proofs/.lake/
proofs/scratch/

# Compiled C++ benchmarks
benches/fflas_fdot_bench
# Stray unstripped ELF committed in 6f21b528; untracked, kept ignored.
crates/gf2-core/lib

# Reference benchmark run outputs (jit:a03b2556)
# compiled reference binaries are produced inside the container and
# bind-mounted out into reference/.
benchmarks/reference/fflas_bench
benchmarks/reference/m4ri_bench
benchmarks/reference/linbox_bench
benchmarks/reference/m4rie_bench
benchmarks/reference/m4rie_one_cell
benchmarks/reference/ntl_bench
benchmarks/reference/flint_bench
benchmarks/reference/ntl_flint_smoke
benchmarks/reference/charpoly_minpoly_smoke
benchmarks/reference/ntl_gf2pow32_smoke

# Charon intermediate output (target/ itself is covered above)
*.llbc

# JIT artifacts
.jit-bootstrap.lock
.claude/worktrees/
.agents/worktrees/
# Shared Cargo build cache for agent worktrees; regenerated on demand.
.agents/cache-pool/
# Bulk tuning-campaign evidence; the committed <run-id>.sha256 manifests pin it.
.agents/campaign-evidence/
# Agent runtime state: campaign stages, bench-window queues, external checkouts, scratch.
.agents/campaign-stages/
.agents/bench-window/
.agents/ext/
.agents/scratch/

benchmarks/reference/fflas_sparse_bench
benchmarks/reference/linbox_sparse_bench
benchmarks/reference/sparse_smoke

# Sparse-smoke ground-truth artefact (jit:96fde7c7). Regenerated on
# every `benchmarks/smoke.sh` invocation by the
# `sparse_smoke_emit_expected` Cargo example. .gitignored so a stale
# committed copy cannot mask gf2-core regressions.
benchmarks/expected/sparse_smoke_n16.bin

# GF(2^32) smoke ground-truth artefact (jit:b13799ac R2). Regenerated on
# every `benchmarks/smoke.sh` / `run.sh --smoke-equality` invocation by
# the `gf2pow32_smoke_emit_expected` Cargo example. .gitignored so a
# stale committed copy cannot mask gf2-core regressions in the
# GF(2^32) matmul path.
benchmarks/expected/gf2pow32_smoke_n16.bin
.claude/scheduled_tasks.lock

# rocprofv1 working directories, created per profiling invocation next to the
# real outputs it is asked to write. Tool scratch, not measurement evidence.
rpl_data_*/

# GPU hard-fail diagnostic dumps (gf2-sim `42eac5cc`; runtime-generated per fatal GPU event)
__pycache__/

# Copied inputs and raw single-host output (@/inv/committed-evidence-budget).
**/inputs/producing/
**/source-inputs/
perf.data*

# The tracker repository, mounted here
/.jit/

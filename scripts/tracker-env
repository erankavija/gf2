#!/bin/sh
# Runs a command, typically jit, with the tracker environment of the invoking
# checkout, so a linked worktree reaches the primary checkout's store.
#
#   JIT_DATA_DIR       .jit under the primary checkout, the parent of the git
#                      common directory
#   JIT_WORKTREE_ROOT  the invoking checkout's top level
#   JIT_AGENT_ID       kept when set; in a linked worktree otherwise the
#                      holder of the active lease on the issues a `jit gate`
#                      command names, or else agent:<name git registers the
#                      worktree under>; in the primary checkout otherwise
#                      unset, so jit uses its configured agent
#
# A gate run from a linked worktree thus records the caller's JIT_AGENT_ID,
# the issue's lease holder, or the worktree's name, in that order. The lease
# lookup covers the gate subcommands that name issues (evaluate, eval,
# evaluate-all, fail, add, status, status-all, evaluate-many), with jit's
# global and gate options anywhere before the subcommand, and runs the
# command's own jit. Issues leased by different agents are refused; a failed
# lookup or no lease keeps the worktree's name.
#
#   tracker-env <command> [args...]   exec the command in that environment
#   tracker-env                       print export lines for `eval`
#
# It refuses, running nothing, when the primary checkout holds no store
# (no index.json under its .jit) and when a linked worktree holds a .jit of
# its own, which is a stale or worktree-local store.
set -eu

die() {
  printf 'tracker-env: %s\n' "$*" >&2
  exit 1
}

physical() { (cd "$1" && pwd -P); }

top=$(git rev-parse --show-toplevel) || die "not inside a git checkout"
common=$(physical "$(git rev-parse --git-common-dir)") ||
  die "cannot resolve the git common directory"
gitdir=$(physical "$(git rev-parse --absolute-git-dir)") ||
  die "cannot resolve the git directory"
primary=$(dirname "$common")
store="$primary/.jit"

if [ "$gitdir" != "$common" ]; then
  if [ -e "$top/.jit" ] || [ -L "$top/.jit" ]; then
    die "linked worktree holds a store of its own: $top/.jit"
  fi
fi
[ -f "$store/index.json" ] || die "no tracker store at $store (missing index.json)"

JIT_DATA_DIR=$store
JIT_WORKTREE_ROOT=$top
export JIT_DATA_DIR JIT_WORKTREE_ROOT

# Prints, one per line, the issues a `jit [options] gate [options]
# <subcommand> ...` command names: the first operand of the subcommands that
# take one issue, every operand after the gate key of evaluate-many.
gate_issues() {
  [ "$#" -ge 1 ] && [ "$(basename "$1")" = jit ] || return 1
  shift
  stage=gate sub='' skip='' operands=0 found=1
  for arg do
    if [ -n "$skip" ]; then
      skip=
      continue
    fi
    case $stage:$arg in
    gate:gate) stage=sub ;;
    gate:-* | sub:-*) ;;
    gate:*) return 1 ;;
    sub:evaluate | sub:eval | sub:evaluate-all | sub:fail | sub:add | sub:status | sub:status-all | sub:evaluate-many)
      stage=args sub=$arg ;;
    sub:*) return 1 ;;
    args:--gate | args:-b | args:--by | args:--limit | args:--status | args:--tail) skip=1 ;;
    args:-*) ;;
    args:*)
      operands=$((operands + 1))
      if [ "$sub" != evaluate-many ]; then
        printf '%s\n' "$arg"
        return 0
      fi
      if [ "$operands" -gt 1 ]; then
        printf '%s\n' "$arg"
        found=0
      fi
      ;;
    esac
  done
  return "$found"
}

# Prints the agent holding the active lease on issue $2, using jit $1.
lease_holder() {
  "$1" claim status --issue "$2" --json 2>/dev/null |
    sed -n 's/^ *"agent_id": *"\([^"]*\)".*/\1/p' | sed -n 1p
}

if [ "$gitdir" != "$common" ] && [ "${JIT_AGENT_ID+set}" != set ]; then
  holder='' leased=''
  if issues=$(gate_issues "$@"); then
    while IFS= read -r issue; do
      found=$(lease_holder "$1" "$issue") || found=''
      [ -n "$found" ] || continue
      if [ -n "$holder" ] && [ "$found" != "$holder" ]; then
        die "the issues are leased by different agents ($holder holds $leased, $found holds $issue); set JIT_AGENT_ID to the one that runs the gates"
      fi
      holder=$found
      leased="${leased:+$leased }$issue"
    done <<ISSUES
$issues
ISSUES
  fi
  if [ -n "$holder" ]; then
    printf 'tracker-env: running as %s, the lease holder of %s\n' "$holder" "$leased" >&2
    JIT_AGENT_ID=$holder
  else
    JIT_AGENT_ID="agent:$(basename "$gitdir")"
  fi
  export JIT_AGENT_ID
fi

if [ "$#" -gt 0 ]; then
  exec "$@"
fi

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
printf 'export JIT_DATA_DIR=%s\n' "$(quote "$JIT_DATA_DIR")"
printf 'export JIT_WORKTREE_ROOT=%s\n' "$(quote "$JIT_WORKTREE_ROOT")"
if [ -n "${JIT_AGENT_ID+set}" ]; then
  printf 'export JIT_AGENT_ID=%s\n' "$(quote "$JIT_AGENT_ID")"
fi

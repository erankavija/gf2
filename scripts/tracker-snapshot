#!/bin/sh
# Commits unignored tracker changes while jit holds the store write lock.
# Usage: tracker-snapshot [--push]; exits 0 on a commit or a clean store,
# nonzero on failure.
#
# The commit's subject is `snapshot <UTC time> main <commit>`.
#
# --push, after the commit or on a clean store, pushes the store's main to its
# origin remote, so a snapshot left unpushed earlier also reaches the home. A
# failed push exits nonzero naming the remote and keeps the local commit.
# Without --push the script makes no remote call.
#
# Refuses other arguments, an unavailable store/lock, or a store without its
# own git root.
set -eu

usage() { echo 'usage: tracker-snapshot [--push]' >&2; exit 1; }
push=0
case $# in
0) ;;
1) [ "$1" = --push ] || usage; push=1 ;;
*) usage ;;
esac
scripts=$(cd "$(dirname "$0")" && pwd -P)
TRACKER_SNAPSHOT_PUSH=$push
export TRACKER_SNAPSHOT_PUSH
# shellcheck disable=SC2016 # Expanded by the shell running under the store lock.
exec "$scripts/tracker-env" jit worktree exec -- sh -eu -c '
  data=$(cd "$JIT_DATA_DIR" && pwd -P)
  if [ "$(git -C "$data" rev-parse --show-toplevel)" != "$data" ]; then
    echo "tracker-snapshot: store is not the top level of its own git repository: $data" >&2
    exit 1
  fi
  git -C "$data" add -A
  if git -C "$data" diff --cached --quiet; then
    :
  else
    status=$?
    [ "$status" -eq 1 ] || exit "$status"
    main=$(git -C "$JIT_WORKTREE_ROOT" rev-parse --verify "refs/heads/main^{commit}")
    main=$(printf "%.12s" "$main")
    utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    git -C "$data" commit -m "snapshot $utc main $main"
  fi
  [ "$TRACKER_SNAPSHOT_PUSH" = 1 ] || exit 0
  if ! git -C "$data" push -q origin main; then
    remote=$(git -C "$data" remote get-url origin 2>/dev/null) || remote="(no origin remote)"
    echo "tracker-snapshot: push of main to origin $remote failed; the snapshot stays local" >&2
    exit 1
  fi
'

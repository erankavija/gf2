def gfp.specialized.proth_reduce
  (K : Std.U64) (N : Std.U32) (x : Std.U128) : Result Std.U64 := do
  massert (K >= 1#u64)
  massert (N >= 16#u32)
  massert (N <= 62#u32)
  let i ← lift (UScalar.cast .U128 K)
  let i1 ← 1#u128 <<< N
  let i2 ← i * i1
  let p ← i2 + 1#u128
  let i3 ← x % p
  ok (UScalar.cast .U64 i3)


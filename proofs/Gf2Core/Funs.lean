def gfp.Fp.Insts.Gf2_coreFieldTraitsFiniteFieldU64U128.max_unreduced_additions
  (P : Std.U64) : Result Std.Usize := do
  let i ← lift (UScalar.cast .U128 P)
  let i1 ← i - 1#u128
  let i2 ← lift (UScalar.cast .U128 P)
  let i3 ← i2 - 1#u128
